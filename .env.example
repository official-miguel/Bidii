# Postgres connection string used by Prisma.
#
# ── Neon (recommended) ───────────────────────────────────────────────────────
# Use the *pooler* endpoint (contains "-pooler." in the hostname).
# Required params for PgBouncer compatibility:
#   pgbouncer=true          — disables Prisma's own pooling logic
#   connect_timeout=15      — gives Neon time to wake a cold compute node
# Do NOT include channel_binding=require — PgBouncer doesn't support it and
# will silently drop connections, producing "Error { kind: Closed }" errors.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"

# ── Local Postgres ────────────────────────────────────────────────────────────
# DATABASE_URL="postgresql://user:password@localhost:5432/bidii?schema=public"

# ── Connection pool tuning ────────────────────────────────────────────────────
# When using the Neon pooler (PgBouncer) Prisma can safely hold multiple
# connections because PgBouncer handles fan-out to the real Postgres pool.
# The default is 10. Lower it only if you hit Neon's connection limit.
DATABASE_POOL_SIZE=10

# Used to sign session cookies (any long random string)
SESSION_SECRET="change-this-to-a-long-random-string"

# Encrypts each school's own API keys (Gemini, SMS, WhatsApp, Email, ...)
# before they're stored in the database — set once, back it up like any
# other production secret. Rotating it makes previously-saved keys
# unreadable (schools would need to re-enter them in Settings).
# Generate one with: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY="change-this-to-a-long-random-string"
